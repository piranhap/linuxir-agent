# LinuxIR Agent — environment. Copy to .env and fill in.

# Auth (one of these). Subscription path needs no key — see README.
ANTHROPIC_API_KEY=                 # sk-ant-... (only for --auth api)
CLAUDE_CODE_OAUTH_TOKEN=           # sk-ant-oat01-... (subscription path)

# Obsidian Local REST API (optional — falls back to local vault files if unset/unreachable)
OBSIDIAN_API_KEY=                  # bearer token from the Obsidian Local REST API plugin
OBSIDIAN_HOST=http://localhost:27123

# Threat intel (optional)
VIRUSTOTAL_API_KEY=

# Investigation controls
MAX_ITERATIONS=10
CASE_DIR=./out                     # where case workspaces (vault/audit/Corrections) are written
MAX_AGENT_CONCURRENCY=             # specialists run at once; blank = auto (~1 per 3 GB RAM). Set low (1-2) on small hosts

# Web server
LINUXIR_WEB_HOST=127.0.0.1
LINUXIR_WEB_PORT=8080
